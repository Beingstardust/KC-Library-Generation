    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["scope"],
        "properties": {
            "scope": field_schema,
        },
    }


def _definition_only_schema(allowed_ids: Sequence[str]) -> Dict[str, Any]:
    field_schema = _dynamic_field_schema(allowed_ids)
    return {
        "type": "object",
        "additionalProperties": False,
