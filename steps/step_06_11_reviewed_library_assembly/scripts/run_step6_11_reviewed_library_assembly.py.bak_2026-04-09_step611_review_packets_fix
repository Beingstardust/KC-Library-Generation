from __future__ import annotations

import argparse
import json
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Optional

try:
    import yaml  # type: ignore
except Exception:
    yaml = None

REPO_ROOT = Path(__file__).resolve().parents[3]
REPO_SRC = REPO_ROOT / "src"
if str(REPO_SRC) not in sys.path:
    sys.path.insert(0, str(REPO_SRC))

from kc_l.audit.manifests import build_input_manifest, build_output_manifest, env_snapshot, try_cmd_version
from kc_l.kc.restarted_reviewed_library_assembly import assemble_restarted_reviewed_library
from kc_l.utils.json_io import read_json, write_json


DEFAULT_CONFIG = Path("steps/step_06_11_reviewed_library_assembly/resources/step6_11.slice8.yaml")


def now_utc_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def utc_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d_%H%M%S")


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def load_yaml_or_json(path: Path) -> Dict[str, Any]:
    text = read_text(path)
    if yaml is not None:
        obj = yaml.safe_load(text)
    else:
        obj = json.loads(text)
    if not isinstance(obj, dict):
        raise RuntimeError(f"Expected mapping at config root: {path}")
    return obj


def resolve_repo_path(raw_path: Any, *, base_dir: Optional[Path] = None) -> Path:
    candidate = Path(str(raw_path))
    if candidate.is_absolute():
        return candidate
    root = base_dir if base_dir is not None else REPO_ROOT
    return (root / candidate).resolve()


def rel_path(path: Path) -> str:
    return path.resolve().relative_to(REPO_ROOT.resolve()).as_posix()


def choose_run_paths(
    reviewed_root: Path,
    sandbox_root: Path,
    runs_root: Path,
    reviewed_sets_root: Path,
    sandbox_sets_root: Path,
) -> Dict[str, Path]:
    base_stamp = utc_stamp()
    suffix = 0
    while True:
        run_id = base_stamp if suffix == 0 else f"{base_stamp}_{suffix:02d}"
        reviewed_dir = (reviewed_root / run_id).resolve()
        sandbox_dir = (sandbox_root / run_id).resolve()
        audit_dir = (runs_root / f"{run_id}_step6_11").resolve()
        reviewed_set_path = (reviewed_sets_root / f"{run_id}_step6_11_kc_library_reviewed_restarted_set.json").resolve()
        sandbox_set_path = (sandbox_sets_root / f"{run_id}_step6_11_kc_review_sandbox_restarted_set.json").resolve()
        if not reviewed_dir.exists() and not sandbox_dir.exists() and not audit_dir.exists() and not reviewed_set_path.exists() and not sandbox_set_path.exists():
            return {
                "run_id_step6_11": Path(run_id),
                "reviewed_dir": reviewed_dir,
                "sandbox_dir": sandbox_dir,
                "audit_dir": audit_dir,
                "reviewed_set_path": reviewed_set_path,
                "sandbox_set_path": sandbox_set_path,
            }
        suffix += 1


def copy_config_snapshot(config_path: Path, audit_dir: Path) -> Path:
    target = audit_dir / "config_snapshot.yaml"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(config_path, target)
    return target


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Assemble bounded restarted reviewed-library and sandbox slices from resolved review outcomes.")
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    return parser.parse_args()


def _set_id_from_pathish(value: Any) -> str:
    return Path(str(value)).stem


def main() -> int:
    args = parse_args()
    config_path = resolve_repo_path(args.config)
    cfg = load_yaml_or_json(config_path)

    input_cfg = dict(cfg.get("inputs") or {})
    output_cfg = dict(cfg.get("outputs") or {})

    reviewed_root = resolve_repo_path(output_cfg.get("reviewed_root") or "data/processed/kc_library_reviewed_restarted")
    reviewed_sets_root = resolve_repo_path(output_cfg.get("reviewed_sets_root") or "data/processed/kc_library_reviewed_restarted/_sets")
    sandbox_root = resolve_repo_path(output_cfg.get("sandbox_root") or "data/processed/kc_review_sandbox_restarted")
    sandbox_sets_root = resolve_repo_path(output_cfg.get("sandbox_sets_root") or "data/processed/kc_review_sandbox_restarted/_sets")
    runs_root = resolve_repo_path(output_cfg.get("runs_root") or "data/runs")

    step6_10_set_path = resolve_repo_path(
        input_cfg.get("step6_10_set_manifest")
        or "data/processed/kc_review_audits_restarted_resolved/_sets/2026-03-23_130601_step6_10_kc_review_audits_restarted_resolved_set.json"
    )
    step6_10_set_obj = read_json(step6_10_set_path)
    source_step6_10_set_id = str(step6_10_set_obj.get("set_id") or step6_10_set_path.stem)
    source_step6_10_run_id = str(step6_10_set_obj.get("run_id_step6_10") or "")
    source_resolved_audit_dir = resolve_repo_path(step6_10_set_obj.get("artifacts", {}).get("review_audit_resolved_jsonl")).parent
    resolved_audit_jsonl_path = source_resolved_audit_dir / "review_audit_resolved.jsonl"
    resolution_summary_path = source_resolved_audit_dir / "review_audit_resolution_summary.json"
    resolution_summary = read_json(resolution_summary_path)

    step6_9_set_path = resolve_repo_path(step6_10_set_obj.get("upstream", {}).get("step6_9_set_manifest_json"))
    step6_9_set_obj = read_json(step6_9_set_path)
    source_step6_9_set_id = str(step6_9_set_obj.get("set_id") or step6_9_set_path.stem)
    source_step6_9_run_id = str(step6_9_set_obj.get("run_id_step6_9") or "")
    review_audit_jsonl_path = resolve_repo_path(step6_9_set_obj.get("artifacts", {}).get("review_audit_jsonl"))
    review_audit_summary_path = resolve_repo_path(step6_9_set_obj.get("artifacts", {}).get("review_audit_summary_json"))

    step6_8_set_path = resolve_repo_path(step6_10_set_obj.get("upstream", {}).get("step6_8_set_manifest_json"))
    step6_8_set_obj = read_json(step6_8_set_path)
    source_step6_8_set_id = str(step6_8_set_obj.get("set_id") or step6_8_set_path.stem)
    source_step6_8_run_id = str(step6_8_set_obj.get("run_id_step6_8") or "")
    source_review_packet_dir = resolve_repo_path(step6_8_set_obj.get("artifacts", {}).get("review_packet_jsonl")).parent
    review_packet_jsonl_path = source_review_packet_dir / "review_packet.jsonl"
    review_packet_summary_path = source_review_packet_dir / "review_packet_summary.json"
    excluded_cases = list((step6_8_set_obj.get("slice") or {}).get("excluded_kcs") or [])

    step6_7_set_path = resolve_repo_path(step6_8_set_obj.get("upstream", {}).get("step6_7_set_manifest_json"))
    step6_7_set_obj = read_json(step6_7_set_path)
    source_step6_7_set_id = str(step6_7_set_obj.get("set_id") or step6_7_set_path.stem)
    source_step6_7_run_id = str(step6_7_set_obj.get("run_id_step6_7") or "")
    source_draft_dir = resolve_repo_path(step6_7_set_obj.get("artifacts", {}).get("kc_draft_bundles_jsonl")).parent
    kc_draft_bundles_jsonl_path = source_draft_dir / "kc_draft_bundles.jsonl"
    draft_stats_json_path = source_draft_dir / "draft_stats.json"

    step6_6_set_path = resolve_repo_path(step6_7_set_obj.get("upstream", {}).get("step6_6_set_manifest_json"))
    step6_6_set_obj = read_json(step6_6_set_path)

    lineage = {
        "step4_set_id": _set_id_from_pathish((step6_6_set_obj.get("upstream") or {}).get("step4_active_set_target")),
        "step4_5_set_id": _set_id_from_pathish((step6_6_set_obj.get("upstream") or {}).get("step4_5_active_set_target")),
        "step5_set_id": _set_id_from_pathish((step6_6_set_obj.get("upstream") or {}).get("step5_3_active_set_target")),
        "step6_6_set_id": str(step6_6_set_obj.get("set_id") or step6_6_set_path.stem),
        "step6_6_run_id": str(step6_6_set_obj.get("run_id_step6_6") or ""),
        "step6_7_set_id": source_step6_7_set_id,
        "step6_7_run_id": source_step6_7_run_id,
        "step6_8_set_id": source_step6_8_set_id,
        "step6_8_run_id": source_step6_8_run_id,
        "step6_9_set_id": source_step6_9_set_id,
        "step6_9_run_id": source_step6_9_run_id,
        "step6_10_set_id": source_step6_10_set_id,
        "step6_10_run_id": source_step6_10_run_id,
    }

    run_paths = choose_run_paths(reviewed_root, sandbox_root, runs_root, reviewed_sets_root, sandbox_sets_root)
    run_id = str(run_paths["run_id_step6_11"])
    reviewed_dir = run_paths["reviewed_dir"]
    sandbox_dir = run_paths["sandbox_dir"]
    audit_dir = run_paths["audit_dir"]
    reviewed_set_path = run_paths["reviewed_set_path"]
    sandbox_set_path = run_paths["sandbox_set_path"]
    reviewed_dir.mkdir(parents=True, exist_ok=False)
    sandbox_dir.mkdir(parents=True, exist_ok=False)
    audit_dir.mkdir(parents=True, exist_ok=False)
    reviewed_sets_root.mkdir(parents=True, exist_ok=True)
    sandbox_sets_root.mkdir(parents=True, exist_ok=True)

    config_snapshot_path = copy_config_snapshot(config_path, audit_dir)

    result = assemble_restarted_reviewed_library(
        source_resolved_audit_dir=source_resolved_audit_dir,
        source_review_packet_dir=source_review_packet_dir,
        source_draft_dir=source_draft_dir,
        frozen_output_dir=reviewed_dir,
        sandbox_output_dir=sandbox_dir,
        assembly_run_id=run_id,
        lineage=lineage,
        excluded_cases=excluded_cases,
        intentionally_blank_final_fields=list(resolution_summary.get("intentionally_blank_final_fields") or []),
    )

    reviewed_summary = read_json(result.reviewed_summary_path)
    sandbox_summary = read_json(result.sandbox_summary_path)
    input_manifest = build_input_manifest(
        [
            config_path,
            step6_10_set_path,
            resolved_audit_jsonl_path,
            resolution_summary_path,
            step6_9_set_path,
            review_audit_jsonl_path,
            review_audit_summary_path,
            step6_8_set_path,
            review_packet_jsonl_path,
            review_packet_summary_path,
            step6_7_set_path,
            kc_draft_bundles_jsonl_path,
            draft_stats_json_path,
            step6_6_set_path,
        ]
    )
    write_json(audit_dir / "input_manifest.json", input_manifest)

    summary = {
        "run_id": run_id,
        "created_utc": now_utc_iso(),
        "source_step6_6_set_id": lineage["step6_6_set_id"],
        "source_step6_7_set_id": source_step6_7_set_id,
        "source_step6_8_set_id": source_step6_8_set_id,
        "source_step6_9_set_id": source_step6_9_set_id,
        "source_step6_10_set_id": source_step6_10_set_id,
        "source_draft_dir": rel_path(source_draft_dir),
        "source_review_packet_dir": rel_path(source_review_packet_dir),
        "source_resolved_audit_dir": rel_path(source_resolved_audit_dir),
        "stats": {
            "reviewed_library_summary": reviewed_summary,
            "sandbox_summary": sandbox_summary,
        },
        "env": env_snapshot(),
        "tool_versions": {
            "python": try_cmd_version([sys.executable, "--version"]),
        },
    }
    write_json(audit_dir / "summary.json", summary)

    reviewed_set_manifest = {
        "schema_version": "1.0",
        "kind": "step6_11_kc_library_reviewed_restarted_set",
        "set_id": f"{run_id}_step6_11_kc_library_reviewed_restarted_set",
        "created_utc": now_utc_iso(),
        "run_id_step6_11": run_id,
        "artifacts": {
            "frozen_reviewed_library_jsonl": rel_path(result.frozen_library_path),
            "reviewed_library_summary_json": rel_path(result.reviewed_summary_path),
            "reviewed_library_preview_md": rel_path(result.reviewed_preview_path),
        },
        "upstream": {
            "step6_10_set_manifest_json": rel_path(step6_10_set_path),
            "review_audit_resolved_jsonl": rel_path(resolved_audit_jsonl_path),
            "review_audit_resolution_summary_json": rel_path(resolution_summary_path),
            "step6_9_set_manifest_json": rel_path(step6_9_set_path),
            "step6_8_set_manifest_json": rel_path(step6_8_set_path),
            "step6_7_set_manifest_json": rel_path(step6_7_set_path),
            "step6_6_set_manifest_json": rel_path(step6_6_set_path),
        },
        "slice": {
            "included_kcs": list(reviewed_summary.get("included_kcs") or []),
            "approved_vs_edited_approved_counts": dict(reviewed_summary.get("approved_vs_edited_approved_counts") or {}),
            "rejected_count": int(reviewed_summary.get("rejected_count") or 0),
            "excluded_held_count": int(reviewed_summary.get("excluded_held_count") or 0),
            "intentionally_blank_fields_preserved": list(reviewed_summary.get("intentionally_blank_fields_preserved") or []),
        },
        "audit": {
            "run_dir": rel_path(audit_dir),
            "config_snapshot": rel_path(config_snapshot_path),
            "input_manifest": rel_path(audit_dir / "input_manifest.json"),
            "summary": rel_path(audit_dir / "summary.json"),
            "output_manifest": rel_path(audit_dir / "output_manifest.json"),
        },
    }
    write_json(reviewed_set_path, reviewed_set_manifest)

    sandbox_set_manifest = {
        "schema_version": "1.0",
        "kind": "step6_11_kc_review_sandbox_restarted_set",
        "set_id": f"{run_id}_step6_11_kc_review_sandbox_restarted_set",
        "created_utc": now_utc_iso(),
        "run_id_step6_11": run_id,
        "artifacts": {
            "kc_review_sandbox_jsonl": rel_path(result.sandbox_path),
            "sandbox_summary_json": rel_path(result.sandbox_summary_path),
        },
        "upstream": {
            "step6_10_set_manifest_json": rel_path(step6_10_set_path),
            "review_audit_resolved_jsonl": rel_path(resolved_audit_jsonl_path),
            "review_audit_resolution_summary_json": rel_path(resolution_summary_path),
            "step6_9_set_manifest_json": rel_path(step6_9_set_path),
            "step6_8_set_manifest_json": rel_path(step6_8_set_path),
            "step6_7_set_manifest_json": rel_path(step6_7_set_path),
            "step6_6_set_manifest_json": rel_path(step6_6_set_path),
        },
        "slice": {
            "sandbox_kcs": list(sandbox_summary.get("sandbox_kcs") or []),
            "rejected_kcs": list(sandbox_summary.get("rejected_kcs") or []),
            "excluded_held_kcs": list(sandbox_summary.get("excluded_held_kcs") or []),
            "statuses": dict(sandbox_summary.get("statuses") or {}),
        },
        "audit": {
            "run_dir": rel_path(audit_dir),
            "config_snapshot": rel_path(config_snapshot_path),
            "input_manifest": rel_path(audit_dir / "input_manifest.json"),
            "summary": rel_path(audit_dir / "summary.json"),
            "output_manifest": rel_path(audit_dir / "output_manifest.json"),
        },
    }
    write_json(sandbox_set_path, sandbox_set_manifest)

    output_manifest = {
        "processed_outputs": {
            "reviewed_library": build_output_manifest(reviewed_dir),
            "review_sandbox": build_output_manifest(sandbox_dir),
        },
        "audit_outputs": build_output_manifest(audit_dir),
        "set_manifests": {
            "reviewed_library": {"path": rel_path(reviewed_set_path)},
            "review_sandbox": {"path": rel_path(sandbox_set_path)},
        },
    }
    write_json(audit_dir / "output_manifest.json", output_manifest)

    print(
        json.dumps(
            {
                "run_id": run_id,
                "reviewed_dir": rel_path(reviewed_dir),
                "sandbox_dir": rel_path(sandbox_dir),
                "audit_dir": rel_path(audit_dir),
                "frozen_reviewed_entry_count": reviewed_summary.get("frozen_reviewed_entry_count"),
                "sandbox_entry_count": sandbox_summary.get("sandbox_entry_count"),
            },
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
