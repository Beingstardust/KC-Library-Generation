from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import math
import os
import re
import sys
import time
from collections import Counter
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

import numpy as np

try:
    import yaml  # type: ignore
except Exception:
    yaml = None

REPO_SRC = Path(__file__).resolve().parents[3] / "src"
if str(REPO_SRC) not in sys.path:
    sys.path.insert(0, str(REPO_SRC))

from kc_l.audit.manifests import env_snapshot, try_cmd_version


EXPECTED_EMBED_MODEL = "qwen3-embedding:8b-q4_K_M"
EXPECTED_EMBED_DIM = 4096
ACTIVE_STEP5_2_EVIDENCE_SHARP_SET = Path("data/processed/kc_evidence_sharp/_sets/ACTIVE_STEP5_2_EVIDENCE_SHARP_SET.txt")
TOKEN_RE = re.compile(r"[A-Za-z0-9]+")
SENTENCE_SPLIT_RE = re.compile(r"(?:\r?\n)+|(?<=[\.\?!;:])\s+")
LAYER_PRIORITY = {"mineru": 3.0, "docling": 2.0, "pymupdf": 1.0}


def now_utc_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def utc_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d_%H%M%S")


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def write_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def write_jsonl(path: Path, rows: Iterable[Mapping[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        for row in rows:
            handle.write(json.dumps(dict(row), ensure_ascii=False) + "\n")


def jsonl_iter(path: Path) -> Iterable[Dict[str, Any]]:
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            yield json.loads(line)


def load_yaml(path: Path) -> Dict[str, Any]:
    if yaml is None:
        raise RuntimeError("PyYAML is required for Step 5.2.")
    obj = yaml.safe_load(read_text(path))
    if not isinstance(obj, dict):
        raise RuntimeError(f"Expected mapping at config root: {path}")
    return obj


def load_json(path: Path) -> Dict[str, Any]:
    obj = json.loads(read_text(path))
    if not isinstance(obj, dict):
        raise RuntimeError(f"Expected JSON object: {path}")
    return obj


def sha256_file(path: Path) -> str:
    hasher = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def rel_path(path: Path, repo_root: Path) -> str:
    return path.resolve().relative_to(repo_root.resolve()).as_posix()


def describe_path(path: Path, repo_root: Path) -> Dict[str, Any]:
    payload: Dict[str, Any] = {"path": rel_path(path, repo_root), "exists": path.exists()}
    if path.exists() and path.is_file():
        stat = path.stat()
        payload["sha256"] = sha256_file(path)
        payload["stat"] = {
            "size_bytes": int(stat.st_size),
            "mtime_utc": datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc).isoformat().replace("+00:00", "Z"),
        }
    return payload


def build_repo_manifest(paths: Sequence[Path], repo_root: Path) -> List[Dict[str, Any]]:
    seen: set[Path] = set()
    manifest: List[Dict[str, Any]] = []
    for path in paths:
        resolved = path.resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        manifest.append(describe_path(resolved, repo_root))
    manifest.sort(key=lambda item: item["path"])
    return manifest


def resolve_pointer(repo_root: Path, pointer_path: Path) -> Path:
    raw = read_text(pointer_path).strip()
    if not raw:
        raise RuntimeError(f"Pointer file is empty: {pointer_path}")
    candidate = Path(raw)
    if not candidate.is_absolute():
        candidate = (pointer_path.parent / candidate).resolve()
    return candidate


def normalize_ws(text: str) -> str:
    return " ".join(str(text).split())


def tokenize_text(text: str, min_len: int = 3) -> List[str]:
    tokens: List[str] = []
    for token in TOKEN_RE.findall(text.lower()):
        if token.isdigit() or len(token) < min_len:
            continue
        tokens.append(token)
    return tokens


def unique_preserve_order(items: Sequence[str]) -> List[str]:
    seen: set[str] = set()
    out: List[str] = []
    for item in items:
        if item in seen:
            continue
        seen.add(item)
        out.append(item)
    return out


def close_token_match(target: str, candidate: str) -> bool:
    if target == candidate:
        return True
    if len(target) >= 6 and candidate == target + target[-1]:
        return True
    if len(candidate) >= 6 and target == candidate + candidate[-1]:
        return True
    return False


def count_token_hits(target_tokens: Sequence[str], candidate_tokens: Sequence[str]) -> int:
    candidate_unique = unique_preserve_order(candidate_tokens)
    matched = 0
    for target in unique_preserve_order(target_tokens):
        if any(close_token_match(target, candidate) for candidate in candidate_unique):
            matched += 1
    return matched


def contains_token_sequence(target_tokens: Sequence[str], candidate_tokens: Sequence[str]) -> bool:
    if not target_tokens or len(candidate_tokens) < len(target_tokens):
        return False
    for start_idx in range(0, len(candidate_tokens) - len(target_tokens) + 1):
        window = candidate_tokens[start_idx : start_idx + len(target_tokens)]
        if all(close_token_match(target, candidate) for target, candidate in zip(target_tokens, window)):
            return True
    return False


def split_sentences(text: str) -> List[str]:
    parts = [normalize_ws(part) for part in SENTENCE_SPLIT_RE.split(text) if normalize_ws(part)]
    return parts


def cue_in_text(text: str, cue: str) -> bool:
    if " " in cue:
        return cue in text
    return re.search(rf"\b{re.escape(cue)}\b", text) is not None


def literal_snippet(source_text: str, preferred_terms: Sequence[str], max_chars: int) -> str:
    if not source_text:
        return ""
    if max_chars <= 0:
        return source_text
    lower = source_text.lower()
    best_idx: Optional[int] = None
    for term in preferred_terms:
        if not term:
            continue
        idx = lower.find(term.lower())
        if idx == -1:
            continue
        if best_idx is None or idx < best_idx:
            best_idx = idx
    if best_idx is None:
        best_idx = next((idx for idx, char in enumerate(source_text) if not char.isspace()), 0)
    start = max(0, best_idx - (max_chars // 4))
    end = min(len(source_text), start + max_chars)
    if end - start < max_chars and end == len(source_text):
        start = max(0, end - max_chars)
    while start < end and source_text[start].isspace():
        start += 1
    while end > start and source_text[end - 1].isspace():
        end -= 1
    return source_text[start:end]


def percentile(values: Sequence[float], p: float) -> float:
    if not values:
        return 0.0
    ordered = sorted(values)
    index = max(0, math.ceil(p * len(ordered)) - 1)
    return float(ordered[index])


def choose_run_paths(repo_root: Path, processed_root_rel: str, runs_dir_rel: str, sets_dir_rel: str) -> Dict[str, Path]:
    base_stamp = utc_stamp()
    suffix = 0
    while True:
        run_id = base_stamp if suffix == 0 else f"{base_stamp}_{suffix:02d}"
        processed_dir = (repo_root / processed_root_rel / run_id).resolve()
        audit_dir = (repo_root / runs_dir_rel / f"{run_id}_step5_2").resolve()
        set_path = (repo_root / sets_dir_rel / f"{run_id}_step5_2_kc_evidence_sharp_set.json").resolve()
        if not processed_dir.exists() and not audit_dir.exists() and not set_path.exists():
            return {
                "run_id_step5_2": Path(run_id),
                "processed_dir": processed_dir,
                "audit_dir": audit_dir,
                "set_path": set_path,
            }
        suffix += 1


def import_helper(repo_root: Path, rel_script_path: str, module_name: str):
    helper_path = (repo_root / rel_script_path).resolve()
    spec = importlib.util.spec_from_file_location(module_name, helper_path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Unable to import helper module from {helper_path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


@dataclass
class AuditLog:
    path: Path

    def info(self, message: str) -> None:
        line = f"[{now_utc_iso()}] {message}"
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with self.path.open("a", encoding="utf-8") as handle:
            handle.write(line + "\n")
        print(line)


@dataclass
class KCProfile:
    kc_id: str
    canonical_name: str
    aliases: List[str]
    seed_definition: str
    canonical_tokens: List[str]
    alias_tokens: List[str]
    name_alias_tokens: List[str]
    canonical_phrase_tokens: List[str]
    alias_phrase_tokens: List[List[str]]
    seed_keywords: List[str]
    preferred_snippet_terms: List[str]


def build_kc_profile(kc_row: Mapping[str, Any], s5: Any, s4: Any, cfg: Mapping[str, Any]) -> KCProfile:
    canonical_name = str(kc_row.get("canonical_name") or "").strip()
    aliases = [str(alias).strip() for alias in (kc_row.get("aliases") or []) if str(alias).strip()]
    seed_definition = str(kc_row.get("seed_definition") or "").strip()
    canonical_tokens = unique_preserve_order(tokenize_text(canonical_name, min_len=3))
    alias_tokens = unique_preserve_order(
        token for alias in aliases for token in tokenize_text(alias, min_len=3)
    )
    seed_keywords = unique_preserve_order(
        s5.extract_keywords(
            canonical_name,
            seed_definition,
            s4,
            max_terms=int(cfg["runtime"]["keyword_query_max_terms"]),
        )
    )
    preferred_terms = unique_preserve_order(
        [canonical_name]
        + aliases
        + canonical_tokens
        + alias_tokens
        + seed_keywords
    )
    return KCProfile(
        kc_id=str(kc_row["kc_id"]),
        canonical_name=canonical_name,
        aliases=aliases,
        seed_definition=seed_definition,
        canonical_tokens=canonical_tokens,
        alias_tokens=alias_tokens,
        name_alias_tokens=unique_preserve_order(canonical_tokens + alias_tokens),
        canonical_phrase_tokens=tokenize_text(canonical_name, min_len=1),
        alias_phrase_tokens=[tokenize_text(alias, min_len=1) for alias in aliases if tokenize_text(alias, min_len=1)],
        seed_keywords=seed_keywords,
        preferred_snippet_terms=preferred_terms,
    )


def build_alignment(candidate: Dict[str, Any], doc_ctx: Any, profile: KCProfile, cfg: Mapping[str, Any]) -> Dict[str, Any]:
    source_text = str(candidate.get("_source_text") or "")
    patch_heading = str(candidate.get("patch_heading") or "")
    combined_text = normalize_ws(f"{source_text} {patch_heading}")
    combined_tokens = tokenize_text(combined_text, min_len=3)
    heading_tokens = tokenize_text(patch_heading, min_len=3)
    phrase_tokens = tokenize_text(combined_text, min_len=1)
    canonical_hits = count_token_hits(profile.canonical_tokens, combined_tokens)
    alias_hits = count_token_hits(profile.alias_tokens, combined_tokens)
    seed_hits = count_token_hits(profile.seed_keywords, combined_tokens)
    heading_hits = count_token_hits(profile.name_alias_tokens, heading_tokens)
    exact_name_phrase = contains_token_sequence(profile.canonical_phrase_tokens, phrase_tokens)
    exact_alias_phrase = any(contains_token_sequence(alias_tokens, phrase_tokens) for alias_tokens in profile.alias_phrase_tokens)

    cue_list = [str(cue).strip().lower() for cue in cfg["alignment"]["definitional_cues"] if str(cue).strip()]
    content_tokens = tokenize_text(source_text, min_len=3)
    content_unique = len(set(content_tokens))
    cue_hits = 0
    cue_with_name_hits = 0
    for sentence in split_sentences(source_text):
        sentence_lower = sentence.lower()
        sentence_tokens = tokenize_text(sentence, min_len=3)
        has_cue = any(cue_in_text(sentence_lower, cue) for cue in cue_list)
        if not has_cue:
            continue
        cue_hits += 1
        if count_token_hits(profile.name_alias_tokens, sentence_tokens) > 0 or (
            profile.canonical_phrase_tokens and contains_token_sequence(profile.canonical_phrase_tokens, tokenize_text(sentence, min_len=1))
        ):
            cue_with_name_hits += 1

    layer = str(candidate.get("layer") or "").lower()
    layer_priority = float(LAYER_PRIORITY.get(layer, 0.0))
    page_index = int(candidate.get("page_index", -1))
    reveal_group_id = candidate.get("reveal_group_id")
    is_noncanonical = bool(doc_ctx.page_to_noncanon.get(page_index, False))
    is_canonical_reveal = bool(reveal_group_id not in (None, "") and not is_noncanonical)

    thresholds = cfg["alignment"]["thresholds"]
    weights = cfg["alignment"]["weights"]
    short_block = len(source_text.strip()) < int(thresholds["short_block_chars"]) or len(content_tokens) < int(thresholds["short_block_tokens"])
    generic_block = content_unique <= int(thresholds["generic_unique_content_tokens"])

    score = 0.0
    score += float(weights["exact_name_phrase"]) if exact_name_phrase else 0.0
    score += float(weights["exact_alias_phrase"]) if exact_alias_phrase else 0.0
    score += canonical_hits * float(weights["canonical_token"])
    score += alias_hits * float(weights["alias_token"])
    score += seed_hits * float(weights["seed_keyword"])
    score += min(cue_hits, 3) * float(weights["definitional_cue_sentence"])
    score += min(cue_with_name_hits, 2) * float(weights["definition_plus_name_sentence"])
    score += float(weights["heading_phrase"]) if (not exact_name_phrase and heading_hits > 0) else 0.0
    score += min(heading_hits, 3) * float(weights["heading_token"])
    score += float(candidate["scores"]["combined"]) * float(weights["retrieval_combined"])
    score += layer_priority * float(weights["layer_priority"])
    if is_canonical_reveal:
        score += float(weights["canonical_reveal_bonus"])
    elif reveal_group_id not in (None, "") and is_noncanonical:
        score -= float(weights["noncanonical_reveal_penalty"])
    if short_block:
        score -= float(weights["short_block_penalty"])
    if generic_block:
        score -= float(weights["generic_block_penalty"])

    return {
        "score": float(score),
        "name_or_alias_hit": bool(canonical_hits or alias_hits or exact_name_phrase or exact_alias_phrase),
        "exact_name_phrase": bool(exact_name_phrase),
        "exact_alias_phrase": bool(exact_alias_phrase),
        "canonical_name_token_hits": int(canonical_hits),
        "alias_token_hits": int(alias_hits),
        "name_or_alias_token_hits": int(canonical_hits + alias_hits),
        "seed_keyword_hits": int(seed_hits),
        "heading_name_or_alias_hits": int(heading_hits),
        "definitional_cue_sentence_hits": int(cue_hits),
        "definition_plus_name_sentence_hits": int(cue_with_name_hits),
        "short_block_penalty_applied": bool(short_block),
        "generic_block_penalty_applied": bool(generic_block),
        "layer_priority": float(layer_priority),
        "canonical_reveal_page": bool(is_canonical_reveal),
        "noncanonical_reveal_page": bool(reveal_group_id not in (None, "") and is_noncanonical),
    }


def candidate_sort_key(candidate: Mapping[str, Any]) -> Tuple[Any, ...]:
    alignment = candidate["alignment"]
    retrieval_scores = candidate["scores"]
    return (
        int(alignment["name_or_alias_hit"]),
        int(alignment["exact_name_phrase"]),
        int(alignment["exact_alias_phrase"]),
        int(alignment["name_or_alias_token_hits"]),
        int(alignment["definitional_cue_sentence_hits"]),
        float(alignment["score"]),
        float(retrieval_scores["combined"]),
        float(retrieval_scores.get("navigate_score") or 0.0),
        float(alignment["layer_priority"]),
        str(candidate["doc_id"]),
        int(candidate["page_index"]),
        str(candidate["block_id"]),
    )


def better_candidate(candidate: Mapping[str, Any], current: Mapping[str, Any]) -> bool:
    return candidate_sort_key(candidate) > candidate_sort_key(current)


def dedupe_candidates_sharp(candidates: Sequence[Dict[str, Any]], enable_reveal_fp_dedupe: bool, s4: Any) -> List[Dict[str, Any]]:
    by_block: Dict[Tuple[str, str], Dict[str, Any]] = {}
    for candidate in candidates:
        key = (str(candidate["doc_id"]), str(candidate["block_id"]))
        current = by_block.get(key)
        if current is None or better_candidate(candidate, current):
            by_block[key] = candidate

    deduped = list(by_block.values())
    if not enable_reveal_fp_dedupe:
        return deduped

    by_fp: Dict[Tuple[str, str, str], Dict[str, Any]] = {}
    passthrough: List[Dict[str, Any]] = []
    for candidate in deduped:
        reveal_group_id = candidate.get("reveal_group_id")
        source_text = str(candidate.get("_source_text") or "")
        if reveal_group_id in (None, "") or not source_text:
            passthrough.append(candidate)
            continue
        fp = s4.fingerprint_text(source_text)
        key = (str(candidate["doc_id"]), str(reveal_group_id), fp)
        current = by_fp.get(key)
        if current is None or better_candidate(candidate, current):
            by_fp[key] = candidate

    merged = passthrough + list(by_fp.values())
    merged.sort(key=candidate_sort_key, reverse=True)
    return merged


def apply_diversity_sharp(
    candidates: Sequence[Dict[str, Any]],
    *,
    max_blocks: int,
    max_per_doc: int,
    max_per_page: int,
) -> List[Dict[str, Any]]:
    ordered = sorted(candidates, key=candidate_sort_key, reverse=True)
    selected: List[Dict[str, Any]] = []
    doc_counts: Counter[str] = Counter()
    page_counts: Counter[Tuple[str, int]] = Counter()
    selected_keys: set[Tuple[str, str]] = set()

    for candidate in ordered:
        doc_key = str(candidate["doc_id"])
        page_key = (doc_key, int(candidate["page_index"]))
        block_key = (doc_key, str(candidate["block_id"]))
        if block_key in selected_keys:
            continue
        if doc_counts[doc_key] >= max_per_doc:
            continue
        if page_counts[page_key] >= max_per_page:
            continue
        selected.append(candidate)
        selected_keys.add(block_key)
        doc_counts[doc_key] += 1
        page_counts[page_key] += 1
        if len(selected) >= max_blocks:
            break

    if len(selected) < max_blocks:
        for candidate in ordered:
            doc_key = str(candidate["doc_id"])
            block_key = (doc_key, str(candidate["block_id"]))
            if block_key in selected_keys:
                continue
            if doc_counts[doc_key] >= max_per_doc:
                continue
            selected.append(candidate)
            selected_keys.add(block_key)
            doc_counts[doc_key] += 1
            if len(selected) >= max_blocks:
                break

    selected.sort(key=candidate_sort_key, reverse=True)
    return selected


def public_candidate(candidate: Mapping[str, Any], profile: KCProfile, cfg: Mapping[str, Any]) -> Dict[str, Any]:
    source_text = str(candidate.get("_source_text") or "")
    snippet = literal_snippet(
        source_text,
        preferred_terms=profile.preferred_snippet_terms,
        max_chars=int(cfg["alignment"]["snippet_chars"]),
    )
    if snippet and snippet not in source_text:
        raise RuntimeError("Selected snippet is not a literal substring of the source block text.")
    return {
        "doc_id": candidate["doc_id"],
        "block_id": candidate["block_id"],
        "page_index": int(candidate["page_index"]),
        "bbox": candidate.get("bbox"),
        "layer": candidate["layer"],
        "reveal_group_id": candidate.get("reveal_group_id"),
        "patch_id": candidate.get("patch_id"),
        "patch_heading": candidate.get("patch_heading"),
        "query_used": candidate["query_used"],
        "retrieval_scores": candidate["scores"],
        "alignment_score": float(candidate["alignment"]["score"]),
        "alignment_breakdown": dict(candidate["alignment"]),
        "snippet": snippet,
    }


def list_ollama_models() -> List[str]:
    proc = os.popen("ollama list")
    try:
        output = proc.read()
    finally:
        proc.close()
    models: List[str] = []
    for line in output.splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        parts = re.split(r"\s{2,}", line)
        if parts and parts[0]:
            models.append(parts[0].strip())
    return models


def tool_versions(base_url: str, step5_module: Any, s4: Any) -> Dict[str, Any]:
    versions = step5_module.tool_versions(base_url, s4)
    versions["installed_ollama_models"] = list_ollama_models()
    versions["git"] = try_cmd_version(["git", "--version"])
    return versions


def build_output_manifest(
    repo_root: Path,
    processed_dir: Path,
    audit_dir: Path,
    set_path: Path,
    active_pointer_path: Path,
) -> Dict[str, Any]:
    processed_outputs = []
    if processed_dir.exists():
        for path in sorted(processed_dir.rglob("*")):
            if path.is_file():
                processed_outputs.append(describe_path(path, repo_root))
    audit_outputs = []
    if audit_dir.exists():
        for path in sorted(audit_dir.rglob("*")):
            if path.is_file():
                audit_outputs.append(describe_path(path, repo_root))
    return {
        "processed_outputs": processed_outputs,
        "audit_outputs": audit_outputs,
        "set_manifest": describe_path(set_path, repo_root),
        "active_pointer": describe_path(active_pointer_path, repo_root),
    }


def compute_stats_from_rows(
    rows: Sequence[Mapping[str, Any]],
    *,
    baseline_rows: Optional[Sequence[Mapping[str, Any]]] = None,
) -> Dict[str, Any]:
    candidate_counts = [len(row["evidence"]) for row in rows]
    token_hit_counts = [
        sum(1 for evidence in row["evidence"] if bool(evidence["alignment_breakdown"]["name_or_alias_hit"]))
        for row in rows
    ]
    token_hit_fractions = [
        (hit_count / count) if count else 0.0
        for hit_count, count in zip(token_hit_counts, candidate_counts)
    ]
    per_kc_metrics = []
    for row, hit_count, frac in zip(rows, token_hit_counts, token_hit_fractions):
        per_kc_metrics.append(
            {
                "kc_id": row["kc_id"],
                "canonical_name": row["canonical_name"],
                "candidate_count": len(row["evidence"]),
                "token_hit_count": int(hit_count),
                "token_hit_fraction": float(frac),
                "top_alignment_score": float(row["evidence"][0]["alignment_score"]) if row["evidence"] else 0.0,
            }
        )

    baseline_summary = None
    if baseline_rows is not None:
        baseline_candidate_counts = [len(row["evidence"]) for row in baseline_rows]
        baseline_token_hit_counts = [
            sum(1 for evidence in row["evidence"] if bool(evidence["alignment_breakdown"]["name_or_alias_hit"]))
            for row in baseline_rows
        ]
        baseline_token_hit_fractions = [
            (hit_count / count) if count else 0.0
            for hit_count, count in zip(baseline_token_hit_counts, baseline_candidate_counts)
        ]
        baseline_summary = {
            "median_candidates_per_kc": float(np.median(baseline_candidate_counts)) if baseline_candidate_counts else 0.0,
            "median_token_hit_fraction": float(np.median(baseline_token_hit_fractions)) if baseline_token_hit_fractions else 0.0,
            "p10_token_hit_fraction": percentile(baseline_token_hit_fractions, 0.10),
            "p90_token_hit_fraction": percentile(baseline_token_hit_fractions, 0.90),
            "kcs_with_at_least_8_token_hits": int(sum(1 for count in baseline_token_hit_counts if count >= 8)),
        }

    return {
        "distribution_candidates_per_kc": {
            "min": int(min(candidate_counts) if candidate_counts else 0),
            "median": float(np.median(candidate_counts)) if candidate_counts else 0.0,
            "p10": percentile(candidate_counts, 0.10),
            "p90": percentile(candidate_counts, 0.90),
            "max": int(max(candidate_counts) if candidate_counts else 0),
        },
        "distribution_token_hit_fraction": {
            "median": float(np.median(token_hit_fractions)) if token_hit_fractions else 0.0,
            "p10": percentile(token_hit_fractions, 0.10),
            "p90": percentile(token_hit_fractions, 0.90),
        },
        "kcs_with_at_least_8_token_hits": int(sum(1 for count in token_hit_counts if count >= 8)),
        "per_kc_metrics": sorted(per_kc_metrics, key=lambda item: item["kc_id"]),
        "baseline_step5_comparison": baseline_summary,
    }


def baseline_rows_with_alignment(
    baseline_rows: Sequence[Mapping[str, Any]],
    profiles: Mapping[str, KCProfile],
    block_lookup: Mapping[Tuple[str, str], str],
    cfg: Mapping[str, Any],
) -> List[Dict[str, Any]]:
    aligned_rows: List[Dict[str, Any]] = []
    cue_list = [str(cue).strip().lower() for cue in cfg["alignment"]["definitional_cues"] if str(cue).strip()]
    thresholds = cfg["alignment"]["thresholds"]
    for row in baseline_rows:
        profile = profiles[str(row["kc_id"])]
        aligned_evidence = []
        for evidence in row["evidence"]:
            source_text = str(block_lookup.get((str(evidence["doc_id"]), str(evidence["block_id"])), ""))
            patch_heading = str(evidence.get("patch_heading") or "")
            combined_text = normalize_ws(f"{source_text} {patch_heading}")
            combined_tokens = tokenize_text(combined_text, min_len=3)
            heading_tokens = tokenize_text(patch_heading, min_len=3)
            phrase_tokens = tokenize_text(combined_text, min_len=1)
            canonical_hits = count_token_hits(profile.canonical_tokens, combined_tokens)
            alias_hits = count_token_hits(profile.alias_tokens, combined_tokens)
            cue_hits = 0
            for sentence in split_sentences(source_text):
                if any(cue_in_text(sentence.lower(), cue) for cue in cue_list):
                    cue_hits += 1
            aligned_evidence.append(
                {
                    **evidence,
                    "alignment_breakdown": {
                        "name_or_alias_hit": bool(
                            canonical_hits
                            or alias_hits
                            or contains_token_sequence(profile.canonical_phrase_tokens, phrase_tokens)
                            or any(contains_token_sequence(alias_tokens, phrase_tokens) for alias_tokens in profile.alias_phrase_tokens)
                        ),
                        "canonical_name_token_hits": int(canonical_hits),
                        "alias_token_hits": int(alias_hits),
                        "name_or_alias_token_hits": int(canonical_hits + alias_hits),
                        "heading_name_or_alias_hits": int(count_token_hits(profile.name_alias_tokens, heading_tokens)),
                        "definitional_cue_sentence_hits": int(cue_hits),
                        "short_block_penalty_applied": bool(
                            len(source_text.strip()) < int(thresholds["short_block_chars"])
                            or len(tokenize_text(source_text, min_len=3)) < int(thresholds["short_block_tokens"])
                        ),
                    },
                }
            )
        aligned_rows.append(
            {
                "kc_id": str(row["kc_id"]),
                "canonical_name": profile.canonical_name,
                "evidence": aligned_evidence,
            }
        )
    aligned_rows.sort(key=lambda item: item["kc_id"])
    return aligned_rows


def run() -> int:
    parser = argparse.ArgumentParser(description="STEP 5.2: KC evidence sharpening.")
    parser.add_argument("--config", required=True, help="Repo-relative YAML config path.")
    parser.add_argument("--repo-root", default=".", help="Repository root.")
    args = parser.parse_args()

    repo_root = Path(args.repo_root).resolve()
    config_path = (repo_root / args.config).resolve()
    cfg = load_yaml(config_path)
    s5 = import_helper(repo_root, "steps/step_05_kc_evidence_mining/scripts/run_step5.py", "kc_l_step5_helpers")
    s4 = s5.import_step4_helpers(repo_root)

    inputs_cfg = cfg["inputs"]
    outputs_cfg = cfg["outputs"]
    per_kc_cfg = cfg["retrieval"]["per_kc"]
    dedupe_cfg = cfg["retrieval"]["dedupe"]
    runtime_cfg = cfg["runtime"]
    acceptance_cfg = cfg["acceptance"]

    run_paths = choose_run_paths(
        repo_root=repo_root,
        processed_root_rel=str(outputs_cfg["processed_root"]),
        runs_dir_rel=str(cfg["audit"]["runs_dir"]),
        sets_dir_rel=str(outputs_cfg["sets_dir"]),
    )
    run_id_step5_2 = run_paths["run_id_step5_2"].name
    processed_dir = run_paths["processed_dir"]
    audit_dir = run_paths["audit_dir"]
    set_path = run_paths["set_path"]
    active_pointer_path = (repo_root / ACTIVE_STEP5_2_EVIDENCE_SHARP_SET).resolve()

    audit_dir.mkdir(parents=True, exist_ok=False)
    processed_dir.mkdir(parents=True, exist_ok=False)
    logger = AuditLog(audit_dir / "logs" / "run.log")
    started = time.perf_counter()
    timings: Dict[str, Any] = {"started_utc": now_utc_iso()}

    write_text(audit_dir / "config.snapshot.yaml", read_text(config_path))
    write_json(
        audit_dir / "invocation.json",
        {
            "argv": sys.argv,
            "cwd": ".",
            "repo_root": ".",
            "config_path": rel_path(config_path, repo_root),
        },
    )

    try:
        kc_registry_path = (repo_root / str(inputs_cfg["kc_registry_path"])).resolve()
        if not kc_registry_path.exists():
            raise FileNotFoundError(f"Missing KC registry: {kc_registry_path}")

        step4_pointer_path = (repo_root / str(inputs_cfg["step4_active_set_pointer"])).resolve()
        step4_set_path = resolve_pointer(repo_root, step4_pointer_path)
        step4_set = load_json(step4_set_path)
        patch_target_raw = (
            step4_set["provenance"]["step4_patches_set"]["target_path"]
            if "provenance" in step4_set
            else step4_set.get("input_step4_patches_set")
        )
        if not patch_target_raw:
            raise KeyError("Missing linked Step 4 patches set path in Step 4 manifest.")
        patch_set_path = Path(str(patch_target_raw))
        if not patch_set_path.is_absolute():
            patch_set_path = (step4_set_path.parent / patch_set_path).resolve()
        if not patch_set_path.exists():
            raise FileNotFoundError(f"Missing linked Step 4 patches set: {patch_set_path}")
        patch_set = load_json(patch_set_path)

        baseline_pointer_path = (repo_root / str(inputs_cfg["baseline_step5_active_set_pointer"])).resolve()
        baseline_set_path = resolve_pointer(repo_root, baseline_pointer_path)
        baseline_set = load_json(baseline_set_path)
        baseline_candidates_path = (repo_root / str(baseline_set["artifacts"]["kc_evidence_candidates_jsonl"])).resolve()
        if not baseline_candidates_path.exists():
            raise FileNotFoundError(f"Missing baseline Step 5 candidates: {baseline_candidates_path}")

        step4_run_audit_raw = (
            step4_set["provenance"]["retrieval_run_audit_dir"]
            if "provenance" in step4_set
            else step4_set.get("run_dir_step4_3")
        )
        if not step4_run_audit_raw:
            raise KeyError("Missing Step 4 run audit dir in Step 4 manifest.")
        step4_run_audit_dir = Path(str(step4_run_audit_raw))
        if not step4_run_audit_dir.is_absolute():
            step4_run_audit_dir = (repo_root / step4_run_audit_dir).resolve()
        step4_cfg_path = (step4_run_audit_dir / "config_snapshot.yaml").resolve()
        if not step4_cfg_path.exists():
            raise FileNotFoundError(f"Missing Step 4 config snapshot: {step4_cfg_path}")
        step4_cfg = s5.load_step4_runtime_cfg(step4_cfg_path)

        logger.info(
            "Using active Step 4 index set plus linked Step 4 patches set from frozen provenance: "
            f"{rel_path(step4_set_path, repo_root)} -> {rel_path(patch_set_path, repo_root)}"
        )
        logger.info(f"Using baseline Step 5 set for comparison only: {rel_path(baseline_set_path, repo_root)}")

        write_json(audit_dir / "environment_snapshot.json", env_snapshot())
        write_json(audit_dir / "tool_versions.json", tool_versions(str(step4_cfg["embedding"]["base_url"]), s5, s4))

        registry_rows = [json.loads(line) for line in read_text(kc_registry_path).splitlines() if line.strip()]
        registry_rows = sorted(registry_rows, key=lambda row: str(row["kc_id"]))
        profiles = {
            str(row["kc_id"]): build_kc_profile(row, s5, s4, cfg)
            for row in registry_rows
        }
        logger.info(f"Loaded KC registry rows: {len(registry_rows)}")

        docs_sorted = sorted(step4_set["docs"].keys())
        doc_contexts: Dict[str, Any] = {}
        block_lookup: Dict[Tuple[str, str], str] = {}
        input_paths: List[Path] = [
            config_path,
            kc_registry_path,
            step4_pointer_path,
            step4_set_path,
            patch_set_path,
            step4_cfg_path,
            baseline_pointer_path,
            baseline_set_path,
            baseline_candidates_path,
        ]

        load_started = time.perf_counter()
        for doc_id in docs_sorted:
            doc_ctx, doc_inputs = s5.load_doc_context(repo_root, doc_id, step4_set, patch_set, step4_cfg, s4)
            doc_contexts[doc_id] = doc_ctx
            input_paths.extend(doc_inputs)
            for corpus_row in doc_ctx.indexed_corpus_rows:
                block_lookup[(doc_id, str(corpus_row["block_id"]))] = str(corpus_row.get("text") or "")
            logger.info(f"Loaded doc context: {doc_id} rows={len(doc_ctx.index_rows)} patches={len(doc_ctx.patch_docs)}")
        timings["load_seconds"] = round(time.perf_counter() - load_started, 3)

        write_json(audit_dir / "input_manifest.json", build_repo_manifest(input_paths, repo_root))

        queries_by_kc: Dict[str, List[str]] = {}
        all_queries: List[str] = []
        for row in registry_rows:
            queries = s5.build_queries(row, cfg, s4)
            queries_by_kc[str(row["kc_id"])] = queries
            all_queries.extend(queries)
        unique_queries = sorted(set(all_queries))
        logger.info(f"Prepared KC queries: kcs={len(registry_rows)} unique_queries={len(unique_queries)}")

        embed_started = time.perf_counter()
        embedding_cfg = step4_cfg["embedding"]
        query_vectors: Dict[str, np.ndarray] = {}
        query_embed_batch_size = int(runtime_cfg.get("query_embed_batch_size", 32))
        for start_idx in range(0, len(unique_queries), query_embed_batch_size):
            batch = unique_queries[start_idx : start_idx + query_embed_batch_size]
            truncated_batch = [s4.pretruncate(query, int(embedding_cfg["max_chars"])) for query in batch]
            embeddings = s4.ollama_embed(
                base_url=str(embedding_cfg["base_url"]),
                model=str(embedding_cfg["model"]),
                inputs=truncated_batch,
                truncate=bool(embedding_cfg["truncate"]),
                dimensions=int(embedding_cfg["dimensions"]),
                keep_alive=str(embedding_cfg["keep_alive"]),
                options=dict(embedding_cfg.get("options", {})),
                timeout_s=240.0,
            )
            arr = np.asarray(embeddings, dtype=np.float32)
            if arr.shape != (len(batch), EXPECTED_EMBED_DIM):
                raise RuntimeError(f"Unexpected query embedding batch shape: {arr.shape}")
            if bool(step4_cfg["vector_index"].get("l2_normalize", True)):
                arr = s4.l2_normalize(arr)
            for query, vector in zip(batch, arr):
                query_vectors[query] = vector
        timings["query_embedding_seconds"] = round(time.perf_counter() - embed_started, 3)

        retrieval_started = time.perf_counter()
        sharp_rows: List[Dict[str, Any]] = []
        review_rows: List[Dict[str, Any]] = []
        per_doc_contrib: Counter[str] = Counter()

        for row in registry_rows:
            kc_id = str(row["kc_id"])
            profile = profiles[kc_id]
            queries = queries_by_kc[kc_id]
            raw_candidates: List[Dict[str, Any]] = []
            best_patch_headings: Dict[str, float] = {}

            for query in queries:
                query_vector = query_vectors[query]
                for doc_id in docs_sorted:
                    doc_ctx = doc_contexts[doc_id]
                    nav = s5.navigate_rank(doc_ctx, query, int(per_kc_cfg["top_patches_per_doc"]), s4)
                    for patch_id, nav_score in nav:
                        heading = doc_ctx.patch_heading_map.get(patch_id, "")
                        if heading:
                            current = best_patch_headings.get(heading)
                            if current is None or float(nav_score) > current:
                                best_patch_headings[heading] = float(nav_score)
                    fetched = s5.fetch_rank(
                        doc_ctx=doc_ctx,
                        query=query,
                        query_vector=query_vector,
                        selected_nav=nav,
                        top_blocks=int(per_kc_cfg["top_blocks_per_doc"]),
                        scoring_cfg=step4_cfg["scoring"],
                        s4=s4,
                    )
                    for candidate in fetched:
                        source_text = str(candidate.get("_source_text") or "")
                        if not source_text.strip():
                            continue
                        candidate["alignment"] = build_alignment(candidate, doc_ctx, profile, cfg)
                        raw_candidates.append(candidate)

            deduped = dedupe_candidates_sharp(
                raw_candidates,
                enable_reveal_fp_dedupe=bool(dedupe_cfg.get("dedupe_by_text_fingerprint_within_reveal_group", False)),
                s4=s4,
            )
            selected = apply_diversity_sharp(
                deduped,
                max_blocks=int(per_kc_cfg["max_blocks_per_kc"]),
                max_per_doc=int(per_kc_cfg["max_blocks_per_doc"]),
                max_per_page=int(per_kc_cfg["max_blocks_per_page"]),
            )
            public_rows = [public_candidate(candidate, profile, cfg) for candidate in selected]
            token_hit_count = sum(1 for evidence in public_rows if bool(evidence["alignment_breakdown"]["name_or_alias_hit"]))

            for evidence in public_rows:
                per_doc_contrib[str(evidence["doc_id"])] += 1

            if token_hit_count < int(runtime_cfg["review_queue_min_token_hit_candidates"]):
                review_rows.append(
                    {
                        "kc_id": kc_id,
                        "canonical_name": profile.canonical_name,
                        "reason": f"token_hit_candidates_lt_{int(runtime_cfg['review_queue_min_token_hit_candidates'])}",
                        "selected_candidate_count": len(public_rows),
                        "token_hit_count": int(token_hit_count),
                        "token_hit_fraction": float(token_hit_count / len(public_rows)) if public_rows else 0.0,
                        "queries_tried": queries,
                        "debug_hints": {
                            "best_patch_headings_seen": [
                                heading
                                for heading, _ in sorted(best_patch_headings.items(), key=lambda item: (-item[1], item[0]))[:5]
                            ],
                            "top_alignment_examples": [
                                {
                                    "doc_id": evidence["doc_id"],
                                    "block_id": evidence["block_id"],
                                    "page_index": evidence["page_index"],
                                    "layer": evidence["layer"],
                                    "alignment_score": evidence["alignment_score"],
                                    "name_or_alias_hit": evidence["alignment_breakdown"]["name_or_alias_hit"],
                                    "snippet": evidence["snippet"],
                                }
                                for evidence in public_rows[: int(runtime_cfg["review_examples_per_kc"])]
                            ],
                        },
                    }
                )

            sharp_rows.append(
                {
                    "kc_id": kc_id,
                    "canonical_name": profile.canonical_name,
                    "aliases": profile.aliases,
                    "seed_definition": profile.seed_definition,
                    "evidence": public_rows,
                }
            )

        timings["retrieval_seconds"] = round(time.perf_counter() - retrieval_started, 3)

        sharp_rows = sorted(sharp_rows, key=lambda item: item["kc_id"])
        review_rows = sorted(review_rows, key=lambda item: item["kc_id"])

        baseline_rows = [json.loads(line) for line in read_text(baseline_candidates_path).splitlines() if line.strip()]
        baseline_rows = sorted(baseline_rows, key=lambda item: str(item["kc_id"]))
        baseline_aligned_rows = baseline_rows_with_alignment(baseline_rows, profiles, block_lookup, cfg)

        candidates_path = (processed_dir / "kc_evidence_candidates_sharp.jsonl").resolve()
        stats_path = (processed_dir / "kc_evidence_sharp_stats.json").resolve()
        review_path = (processed_dir / "review_queue.jsonl").resolve()

        write_jsonl(candidates_path, sharp_rows)
        write_jsonl(review_path, review_rows)

        stats_core = compute_stats_from_rows(sharp_rows, baseline_rows=baseline_aligned_rows)
        sample_rows = []
        for row in sorted(sharp_rows, key=lambda item: item["kc_id"])[: int(runtime_cfg["sample_kcs"])]:
            top = row["evidence"][0] if row["evidence"] else None
            token_hit_count = sum(1 for evidence in row["evidence"] if bool(evidence["alignment_breakdown"]["name_or_alias_hit"]))
            sample_rows.append(
                {
                    "kc_id": row["kc_id"],
                    "candidate_count": len(row["evidence"]),
                    "token_hit_count": int(token_hit_count),
                    "token_hit_fraction": float(token_hit_count / len(row["evidence"])) if row["evidence"] else 0.0,
                    "top_doc_id": top["doc_id"] if top else "",
                    "top_page_index": top["page_index"] if top else "",
                    "top_layer": top["layer"] if top else "",
                    "top_alignment_score": top["alignment_score"] if top else 0.0,
                }
            )

        acceptance_failures: List[str] = []
        n_kcs_total = len(sharp_rows)
        candidate_counts = [len(row["evidence"]) for row in sharp_rows]
        token_hit_fractions = [metric["token_hit_fraction"] for metric in stats_core["per_kc_metrics"]]
        kcs_with_8_token_hits = int(stats_core["kcs_with_at_least_8_token_hits"])
        median_candidates = float(np.median(candidate_counts)) if candidate_counts else 0.0
        median_token_hit_fraction = float(np.median(token_hit_fractions)) if token_hit_fractions else 0.0

        if n_kcs_total != int(acceptance_cfg["n_kcs_total"]):
            acceptance_failures.append(
                f"Expected n_kcs_total={int(acceptance_cfg['n_kcs_total'])}, observed {n_kcs_total}"
            )
        if any(count > int(acceptance_cfg["max_candidates_per_kc"]) for count in candidate_counts):
            acceptance_failures.append(
                f"Observed candidate_count > {int(acceptance_cfg['max_candidates_per_kc'])}"
            )
        if median_candidates < float(acceptance_cfg["median_candidates_per_kc_min"]):
            acceptance_failures.append(
                f"Median candidates per KC {median_candidates:.2f} < {float(acceptance_cfg['median_candidates_per_kc_min']):.2f}"
            )
        if median_token_hit_fraction < float(acceptance_cfg["median_token_hit_fraction_min"]):
            acceptance_failures.append(
                f"Median token-hit fraction {median_token_hit_fraction:.4f} < {float(acceptance_cfg['median_token_hit_fraction_min']):.4f}"
            )
        if kcs_with_8_token_hits < int(acceptance_cfg["min_kcs_with_8_token_hits"]):
            acceptance_failures.append(
                f"KCs with at least 8 token-hit candidates {kcs_with_8_token_hits} < {int(acceptance_cfg['min_kcs_with_8_token_hits'])}"
            )

        worst_kcs = sorted(
            stats_core["per_kc_metrics"],
            key=lambda item: (item["token_hit_fraction"], item["token_hit_count"], item["candidate_count"], item["kc_id"]),
        )[:10]
        acceptance_passed = not acceptance_failures

        stats_payload = {
            "run_id_step5_2": run_id_step5_2,
            "n_kcs_total": n_kcs_total,
            "name_alias_hit_definition": "candidate source_text or patch_heading contains canonical_name or alias tokens after deterministic token normalization",
            "distribution_candidates_per_kc": stats_core["distribution_candidates_per_kc"],
            "distribution_token_hit_fraction": stats_core["distribution_token_hit_fraction"],
            "kcs_with_at_least_8_token_hits": kcs_with_8_token_hits,
            "review_queue_count": len(review_rows),
            "per_doc_contribution_counts": dict(sorted(per_doc_contrib.items())),
            "per_kc_metrics": stats_core["per_kc_metrics"],
            "baseline_step5_comparison": stats_core["baseline_step5_comparison"],
            "acceptance": {
                "targets": dict(acceptance_cfg),
                "passed": acceptance_passed,
                "failures": acceptance_failures,
            },
            "diagnostics": {
                "worst_10_kcs_by_token_hit_fraction": worst_kcs,
                "sample_rows": sample_rows,
            },
        }
        write_json(stats_path, stats_payload)

        timings["elapsed_seconds"] = round(time.perf_counter() - started, 3)
        timings["n_kcs_total"] = n_kcs_total
        timings["n_docs"] = len(docs_sorted)
        timings["n_unique_queries"] = len(unique_queries)
        write_json(audit_dir / "timings.json", timings)

        summary_payload = {
            "run_id_step5_2": run_id_step5_2,
            "status": "success" if acceptance_passed else "acceptance_failed",
            "created_utc": now_utc_iso(),
            "n_kcs_total": n_kcs_total,
            "median_candidates_per_kc": median_candidates,
            "median_token_hit_fraction": median_token_hit_fraction,
            "kcs_with_at_least_8_token_hits": kcs_with_8_token_hits,
            "review_queue_count": len(review_rows),
            "acceptance_passed": acceptance_passed,
            "acceptance_failures": acceptance_failures,
            "sample_rows": sample_rows,
            "baseline_step5_comparison": stats_core["baseline_step5_comparison"],
            "set_manifest": rel_path(set_path, repo_root) if acceptance_passed else None,
            "active_pointer": rel_path(active_pointer_path, repo_root) if acceptance_passed else None,
        }
        write_json(audit_dir / "summary.json", summary_payload)

        if acceptance_passed:
            set_payload = {
                "schema_version": "1.0",
                "kind": "step5_2_kc_evidence_sharp_set",
                "set_id": set_path.stem,
                "created_utc": now_utc_iso(),
                "run_id_step5_2": run_id_step5_2,
                "artifacts": {
                    "kc_evidence_candidates_sharp_jsonl": rel_path(candidates_path, repo_root),
                    "kc_evidence_sharp_stats_json": rel_path(stats_path, repo_root),
                    "review_queue_jsonl": rel_path(review_path, repo_root),
                },
                "upstream": {
                    "kc_registry_path": rel_path(kc_registry_path, repo_root),
                    "step4_active_set_pointer": rel_path(step4_pointer_path, repo_root),
                    "step4_active_set_target": rel_path(step4_set_path, repo_root),
                    "step4_linked_patches_set_target": rel_path(patch_set_path, repo_root),
                    "step4_retrieval_run_audit_dir": rel_path(step4_run_audit_dir, repo_root),
                    "step4_retrieval_config_snapshot": rel_path(step4_cfg_path, repo_root),
                    "baseline_step5_active_set_pointer": rel_path(baseline_pointer_path, repo_root),
                    "baseline_step5_active_set_target": rel_path(baseline_set_path, repo_root),
                    "baseline_step5_candidates_jsonl": rel_path(baseline_candidates_path, repo_root),
                },
                "audit": {
                    "run_dir": rel_path(audit_dir, repo_root),
                    "input_manifest": rel_path((audit_dir / "input_manifest.json").resolve(), repo_root),
                    "output_manifest": rel_path((audit_dir / "output_manifest.json").resolve(), repo_root),
                    "summary": rel_path((audit_dir / "summary.json").resolve(), repo_root),
                },
            }
            write_json(set_path, set_payload)
            write_text(active_pointer_path, set_path.name + "\n")
            logger.info(f"Wrote Step 5.2 sharpened evidence set: {rel_path(set_path, repo_root)}")
            logger.info(f"Updated ACTIVE pointer: {rel_path(active_pointer_path, repo_root)} -> {set_path.name}")

        output_manifest = build_output_manifest(repo_root, processed_dir, audit_dir, set_path, active_pointer_path)
        write_json(audit_dir / "output_manifest.json", output_manifest)

        print(f"n_kcs_total={n_kcs_total}")
        print(f"max_candidates_per_kc={max(candidate_counts) if candidate_counts else 0}")
        print(f"median_candidates_per_kc={median_candidates:.2f}")
        print(f"median_name_alias_hit_fraction={median_token_hit_fraction:.4f}")
        print(f"kcs_with_at_least_8_name_alias_hits={kcs_with_8_token_hits}")
        print(f"review_queue_count={len(review_rows)}")
        print(f"acceptance_passed={str(acceptance_passed).lower()}")
        if acceptance_failures:
            print("acceptance_failures:")
            for failure in acceptance_failures:
                print(f"- {failure}")
            print("worst_kcs_by_token_hit_fraction:")
            for item in worst_kcs:
                print(
                    f"- {item['kc_id']} | count={item['candidate_count']} | hits={item['token_hit_count']} | "
                    f"frac={item['token_hit_fraction']:.4f} | {item['canonical_name']}"
                )
        else:
            print("kc_id | candidate_count | token_hit_count | token_hit_fraction | top_doc_id | top_page_index | top_layer | top_alignment_score")
            for row in sample_rows:
                print(
                    f"{row['kc_id']} | {row['candidate_count']} | {row['token_hit_count']} | "
                    f"{row['token_hit_fraction']:.4f} | {row['top_doc_id']} | {row['top_page_index']} | "
                    f"{row['top_layer']} | {row['top_alignment_score']:.4f}"
                )
        return 0 if acceptance_passed else 2
    except Exception as exc:
        write_json(
            audit_dir / "summary.json",
            {
                "run_id_step5_2": run_id_step5_2,
                "status": "failed",
                "created_utc": now_utc_iso(),
                "error": repr(exc),
            },
        )
        write_json(
            audit_dir / "timings.json",
            {
                "elapsed_seconds": round(time.perf_counter() - started, 3),
                "status": "failed",
            },
        )
        logger.info(f"FAILED: {repr(exc)}")
        raise


if __name__ == "__main__":
    raise SystemExit(run())
